// Settings shared by every build of Chirp. XcodeGen attaches this file to the project (project.yml).

// The version people see, and the build number Sparkle compares. Release builds get both from the tag and the CI
// run (Docs/RELEASING.md); these are the values for builds made on your own Mac.
MARKETING_VERSION = 0.2.0
CURRENT_PROJECT_VERSION = 1

// "Beta" turns on the BETA compilation condition (the beta markers) and the AppIconBeta icon. Builds on your own
// Mac are betas. Stable releases set it to nothing.
CHIRP_CHANNEL = Beta

// The public half of the key release updates are signed with (Docs/RELEASING.md). Empty: the build never
// checks for updates.
SPARKLE_PUBLIC_KEY = kHrX5bEdWrmQBR9XEI8ETArCelm7wWNY/YKSZOVjNOc=

// Signing. With no team, builds are signed ad hoc and run on this Mac only (macOS asks for permissions again after
// each rebuild). To sign with your own Apple team, copy Local.xcconfig.example to Local.xcconfig.
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =

#include? "Local.xcconfig"
